<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sts2.SeedFinder.Oracle</RootNamespace>
    <AssemblyName>sts2oracle</AssemblyName>
    <!-- sts2.dll targets .NET 9; the runtime rolls it forward. These conflicts are expected. -->
    <NoWarn>MSB3277</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sts2.SeedFinder.Core\Sts2.SeedFinder.Core.csproj" />
  </ItemGroup>

</Project>
